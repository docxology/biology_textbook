flowchart TD
    ASSESS["Species Assessed"] --> POP{Population Size?}
    POP -->|"N < 50"| CR1["Critically Endangered (CR)<br/>Criterion D"]
    POP -->|"N < 250"| EN1["Endangered (EN)<br/>Criterion D"]
    POP -->|"N < 1,000"| VU1["Vulnerable (VU)<br/>Criterion D"]
    POP -->|"N > 1,000"| DECLINE{Population Trend?}

    DECLINE -->|"≥80% decline<br/>in 10yr/3gen"| CR2["CR<br/>Criterion A"]
    DECLINE -->|"≥50% decline"| EN2["EN<br/>Criterion A"]
    DECLINE -->|"≥30% decline"| VU2["VU<br/>Criterion A"]
    DECLINE -->|"Stable/increasing"| RANGE{Geographic Range?}

    RANGE -->|"AOO < 10 km²"| CR3["CR<br/>Criterion B"]
    RANGE -->|"AOO < 500 km²"| EN3["EN<br/>Criterion B"]
    RANGE -->|"AOO < 2,000 km²"| VU3["VU<br/>Criterion B"]
    RANGE -->|"Widespread"| LC["Least Concern (LC)"]

    CR1 --> ACTION["Conservation Triage"]
    CR2 --> ACTION
    EN1 --> ACTION
    EN2 --> ACTION

    ACTION --> CAPTIVE["Captive Breeding<br/>(Ne ≥ 50 short-term)"]
    ACTION --> HABITAT["Habitat Protection<br/>(Reserve Design)"]
    ACTION --> GENETIC["Genetic Rescue<br/>(Translocation)"]
    ACTION --> MONITOR["Population Monitoring<br/>(PVA Modelling)"]

    style CR1 fill:#d9534f,color:#fff
    style CR2 fill:#d9534f,color:#fff
    style CR3 fill:#d9534f,color:#fff
    style EN1 fill:#f0ad4e,color:#000
    style EN2 fill:#f0ad4e,color:#000
    style EN3 fill:#f0ad4e,color:#000
    style LC fill:#5cb85c,color:#fff
