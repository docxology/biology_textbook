flowchart TB
    subgraph "Three pathways of activation"
        CL["CLASSICAL<br/>IgG/IgM bound to antigen<br/>→ C1q-C1r-C1s<br/>→ C1s cleaves C4 + C2"]
        LE["LECTIN<br/>MBL or ficolins bind<br/>mannose / GlcNAc on pathogens<br/>→ MASP1/MASP2<br/>→ cleaves C4 + C2"]
        AL["ALTERNATIVE<br/>Spontaneous C3 hydrolysis<br/>('C3 tickover') on any surface<br/>lacking inhibitors<br/>→ Factor B + Factor D"]
    end

    CL --> C3conv1["C3 convertase<br/>C4b2a (classical/lectin)"]
    LE --> C3conv1
    AL --> C3conv2["C3 convertase<br/>C3bBb (alternative)"]

    C3conv1 --> C3split["C3 → C3a + C3b"]
    C3conv2 --> C3split

    C3split --> C3a["C3a<br/>(anaphylatoxin)<br/>recruits neutrophils"]
    C3split --> C3b["C3b<br/>(opsonin)<br/>phagocyte CR1"]

    C3b -->|"+ existing C3 convertase"| C5conv["C5 convertase<br/>(C4b2a3b or C3bBb3b)"]
    C5conv --> C5["C5 → C5a + C5b"]
    C5 --> C5a["C5a<br/>(anaphylatoxin,<br/>strongest chemoattractant)"]
    C5 --> MAC["C5b + C6 + C7 + C8 + C9_n<br/>→ MEMBRANE ATTACK COMPLEX<br/>10-nm pore → osmotic lysis"]
