flowchart LR
    Stim["Environmental stimulus<br/>(osmolarity, redox,<br/>host AMP, antibiotic)"] --> HK
    HK["Sensor histidine kinase (HK)<br/>His~P after autophosphorylation<br/>(uses ATP)"] -->|"phosphotransfer"| RR
    RR["Response regulator (RR)<br/>Asp~P; DNA-binding active"] --> OUT["Transcription of target operon<br/>(virulence, motility, biofilm)"]
    RR -->|"phosphatase activity<br/>of HK or RR-Pase"| OFF["Dephosphorylation<br/>resets the switch"]
