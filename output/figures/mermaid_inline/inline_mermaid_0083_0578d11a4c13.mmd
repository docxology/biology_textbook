flowchart TB
    ATP["ATP hydrolysis on SF2-family ATPase"] --> M["DNA-translocation through nucleosome"]
    M --> S["Sliding<br/>(nucleosome moves along DNA)"]
    M --> E["Ejection<br/>(complete histone removal)"]
    M --> X["Exchange<br/>(canonical histone ↔ variant)"]
    M --> A["Spacing<br/>(equal inter-nucleosome distance)"]

    SWI["SWI/SNF (BAF/PBAF)<br/>BRG1 or BRM ATPase<br/>+ ARID1A/B, ARID2,<br/>SMARCB1/INI1, BAF180"] --> S
    SWI --> E
    ISWI["ISWI family<br/>SNF2H, SNF2L ATPase<br/>+ NURF, CHRAC, ACF, RSF"] --> A
    ISWI --> S
    CHD["CHD/NuRD family<br/>CHD1/2/3/4 ATPase<br/>+ MBD3, MTA1/2/3, HDAC1/2"] --> S
    CHD --> E
    INO["INO80 / SWR1<br/>INO80 or SRCAP ATPase"] --> X
    INO --> S

    style SWI fill:#e74c3c,color:#fff
    style ISWI fill:#27ae60,color:#fff
    style CHD fill:#9b59b6,color:#fff
    style INO fill:#3498db,color:#fff
