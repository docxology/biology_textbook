flowchart LR
    subgraph "1. ADAPTATION (memory)"
        A1["Phage / plasmid invasion"] --> A2["Cas1-Cas2 captures<br/>protospacer + PAM"]
        A2 --> A3["Integration at leader end<br/>of CRISPR array<br/>(new spacer added)"]
    end
    subgraph "2. EXPRESSION (surveillance)"
        E1["CRISPR array transcribed<br/>(pre-crRNA)"] --> E2["Cas6 / RNase III + tracrRNA<br/>process into mature crRNA"]
        E2 --> E3["crRNA loaded onto effector<br/>(Cascade / Cas9 / Cas10)"]
    end
    subgraph "3. INTERFERENCE (cleavage)"
        I1["Effector scans DNA<br/>for PAM"] --> I2["crRNA-target base pairing"]
        I2 --> I3["dsDNA cleavage<br/>(Cas3 / Cas9 nuclease)"]
    end
    A3 --> E1
    E3 --> I1
